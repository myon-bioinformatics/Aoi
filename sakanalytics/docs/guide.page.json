{
  "schema": "web-ui-page/1",
  "title": "SakAnalytics 利用ガイド",
  "theme": "modern",
  "description": "観測データセット（1行1試合）から、チーム × シーズンの指標を作るツール。測るだけで、除外や良し悪しの判定はしません。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "📊 測るだけ",
        "🐍 Python 3.11+"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧩 機能一覧",
          "blocks": [
            {
              "type": "section",
              "title": "📥 取得",
              "blocks": [
                {
                  "type": "text",
                  "text": "Python 3.11+ と git が必要です。以下の例はリポジトリ全体を取得して実行します。"
                },
                {
                  "type": "output",
                  "text": "git clone https://github.com/myon-bioinformatics/SakAnalytics.git\ncd SakAnalytics"
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 実行",
              "blocks": [
                {
                  "type": "card",
                  "title": "🧱 境界の値をずらす",
                  "text": "下限に当たる値を ε だけ内側へ動かします（既定のコマンド）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python sakanalytics.py 0 --lo 0 --eps 0.1\n{\"original\": 0.0, \"value\": 0.1, \"boundary\": true}"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "📈 要約統計",
                  "text": "数値の列を要約します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python sakanalytics.py describe 1 2 3\n{\"count\": 3, \"sum\": 6.0, \"mean\": 2.0, \"median\": 2.0, \"min\": 1.0, \"max\": 3.0, \"population_stddev\": 0.816496580927726}"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "📦 コマンドとして導入",
                  "text": "uv があれば、クローンせずに導入できます。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ uv tool install git+https://github.com/myon-bioinformatics/SakAnalytics.git\n$ sakanalytics 0 --lo 0"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "🐍 python",
                  "intro": "🤖 のついた手順は CI で実際に動かし、出た結果をそのまま載せています。",
                  "runbook": {
                    "key": "sakanalytics/python",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/SakAnalytics/main/sakanalytics.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "edge",
                        "title": "🧱 境界の値をずらす",
                        "command": "python sakanalytics.py 0 --lo 0 --eps 0.1",
                        "run": true
                      },
                      {
                        "id": "describe",
                        "title": "📈 要約統計",
                        "command": "python sakanalytics.py describe 1 2 3",
                        "run": true
                      },
                      {
                        "id": "tool",
                        "title": "📦 コマンドとして導入",
                        "command": "uv tool install git+https://github.com/myon-bioinformatics/SakAnalytics.git",
                        "needs": "🌐 ネットワーク"
                      }
                    ]
                  }
                },
                {
                  "label": "⚡ uv",
                  "intro": "uv があれば Python の版を気にせず動きます。",
                  "runbook": {
                    "key": "sakanalytics/uv",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/SakAnalytics/main/sakanalytics.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "edge",
                        "title": "🧱 境界の値をずらす",
                        "command": "uv run --no-project python sakanalytics.py 0 --lo 0 --eps 0.1",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "🎞 GIF デモ",
          "blocks": [
            {
              "type": "text",
              "text": "🎞 まだ GIF はありません。ブラウザテストや実行の様子を GIF にしたら、ここに並びます。",
              "muted": true
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "🔗 リンク",
      "blocks": [
        {
          "type": "links",
          "items": [
            {
              "label": "📖 README",
              "href": "https://github.com/myon-bioinformatics/SakAnalytics#readme"
            },
            {
              "label": "📄 sakanalytics.py",
              "href": "https://github.com/myon-bioinformatics/SakAnalytics/blob/main/sakanalytics.py"
            },
            {
              "label": "🗓️ シーズンの見通し",
              "href": "https://github.com/myon-bioinformatics/SakAnalytics/blob/main/docs/season-simulator.md"
            },
            {
              "label": "🔵 Aoi",
              "href": "https://github.com/myon-bioinformatics/Aoi"
            }
          ]
        }
      ]
    }
  ]
}
