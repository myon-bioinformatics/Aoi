{
  "schema": "web-ui-page/1",
  "title": "QueRyu 利用ガイド",
  "theme": "modern",
  "description": "取得と観測データセットの構築を受け持つツール。取得元への負荷を抑え、いつ・どこから・どのコードで取ったかを毎回記録します。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "🌊 取得と来歴の記録",
        "🐍 Python 3.11+"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧭 使い方",
          "blocks": [
            {
              "type": "section",
              "title": "📥 取得",
              "blocks": [
                {
                  "type": "text",
                  "text": "Python 3.11+ と git が必要です。以下の例はリポジトリ全体を取得して実行します。"
                },
                {
                  "type": "output",
                  "text": "git clone https://github.com/myon-bioinformatics/QueRyu.git\ncd QueRyu"
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 実行",
              "blocks": [
                {
                  "type": "card",
                  "title": "📄 単一ファイルを作る",
                  "text": "配布用の1ファイルを組み立てます。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python scripts/build_single_file.py dist-single/queryu.py"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "❓ ヘルプ",
                  "text": "引数の一覧です。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python dist-single/queryu.py --help"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🗺️ 取得せずに計画を見る",
                  "text": "--plan は件数と待ち時間を見積もるだけで、取得しません。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python dist-single/queryu.py --source your_source --years 2024 \\\n    --cache ./cache --plan --offline"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "🐍 python",
                  "intro": "🤖 のついた手順は CI で実際に動かし、出た結果をそのまま載せています。",
                  "runbook": {
                    "key": "queryu/python",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/QueRyu/main/queryu.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "single",
                        "title": "📄 単一ファイルを作る",
                        "command": "python scripts/build_single_file.py dist-single/queryu.py",
                        "run": true
                      },
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "python dist-single/queryu.py --help",
                        "run": true
                      },
                      {
                        "id": "plan",
                        "title": "🗺️ 取得せずに計画を見る",
                        "command": "python dist-single/queryu.py --source your_source --years 2024 --cache ./cache --plan --offline",
                        "needs": "🔭 BlueProbe の checkout（PYTHONPATH）"
                      }
                    ]
                  }
                },
                {
                  "label": "⚡ uv",
                  "intro": "uv があれば Python の版を気にせず動きます。",
                  "runbook": {
                    "key": "queryu/uv",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/QueRyu/main/queryu.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "single",
                        "title": "📄 単一ファイルを作る",
                        "command": "uv run --no-project python scripts/build_single_file.py dist-single/queryu.py",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "🎞 GIF デモ",
          "blocks": [
            {
              "type": "text",
              "text": "🎞 まだ GIF はありません。ブラウザテストや実行の様子を GIF にしたら、ここに並びます。",
              "muted": true
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "🔗 リンク",
      "blocks": [
        {
          "type": "links",
          "items": [
            {
              "label": "📦 リポジトリ",
              "href": "https://github.com/myon-bioinformatics/QueRyu"
            },
            {
              "label": "📖 README",
              "href": "https://github.com/myon-bioinformatics/QueRyu#readme"
            },
            {
              "label": "❓ 質問に答える ask",
              "href": "https://github.com/myon-bioinformatics/QueRyu/blob/main/docs/ask.md"
            },
            {
              "label": "🔭 BlueProbe（観測）",
              "href": "https://github.com/myon-bioinformatics/BlueProbe"
            },
            {
              "label": "🔵 Aoi",
              "href": "https://github.com/myon-bioinformatics/Aoi"
            }
          ]
        }
      ]
    }
  ]
}
