{
  "schema": "web-ui-page/1",
  "title": "🐉 DRAgoWing 利用ガイド",
  "theme": "modern",
  "description": "記録した野球の研究結果を、判定をやり直さずに Plotly.js の HTML レポート・命題の表・SVG にするリポジトリ（Aoi の可視化担当）。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "📈 HTML レポート",
        "🧰 python -S で動く",
        "🌡️ ヒートマップはポートフォリオで公開"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧩 機能一覧",
          "blocks": [
            {
              "type": "section",
              "title": "🧭 ブラウザで開く",
              "blocks": [
                {
                  "type": "links",
                  "items": [
                    {
                      "label": "🌡️ ヒートマップ",
                      "href": "https://myon-bioinformatics.github.io/tools/#heatmap"
                    },
                    {
                      "label": "🖼 Image Studio（シーンを編集）",
                      "href": "https://myon-bioinformatics.github.io/tools/#image-studio"
                    }
                  ]
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 手元で動かす",
              "blocks": [
                {
                  "type": "card",
                  "title": "📈 レポートを作る",
                  "text": "season.jsonl と propositions.jsonl のあるディレクトリから HTML（と SVG）を書き出します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S dragowing.py RESULTS_DIR --out build/dragowing"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🌡️ 行列 → シーン JSON",
                  "text": "Ironmate の Image Studio で開けるシーン JSON にします（- は標準入力）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S dragowing.py --heatmap matrix.json > scene.json"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🔢 HTML の要素を数える",
                  "text": "ディレクトリでないものを渡すと、ブラウザなしで要素を数えます。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S dragowing.py report.html"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🧪 ヒートマップの画面を組む",
                  "text": "ポートフォリオは公開時にこれを呼び、tools/heatmap/ に載せます。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "uv run --only-group pages python scripts/build_heatmap_page.py > heatmap.html"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "⚡ そのまま",
                  "intro": "📋 コピーして手元で試し、結果を記録できます。🤖 の手順は、Pages の公開で実際に動かした結果も載ります。",
                  "runbook": {
                    "key": "dragowing/verify",
                    "steps": [
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "python3 -S dragowing.py --help",
                        "run": true
                      },
                      {
                        "id": "heatmap",
                        "title": "🌡️ 行列 → ヒートマップのシーン",
                        "command": "printf '[[1,2],[3,4]]' | python3 -S dragowing.py --heatmap /dev/stdin | { head -c 240 && cat >/dev/null; }",
                        "expect": "{\"schema\": \"ironmate-image-studio/1\", \"width\": 1280, \"height\": 720, …",
                        "expect_stdout_contains": "{\"schema\": \"ironmate-image-studio/1\", \"width\": 1280, \"height\": 720,",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "🎞 GIF デモ",
          "blocks": [
            {
              "type": "card",
              "title": "🌡️ ヒートマップ",
              "text": "行列を貼って描画し、色の段階と値の表示を切り替えます。Plotly の heatmap トレースも読めます（PC 幅とスマホ幅）。",
              "blocks": [
                {
                  "type": "image",
                  "src": "./demos/heatmap.gif",
                  "alt": "DRAgoWing heatmap editor: drawing a pasted matrix, changing the colour steps and labels, reading a Plotly heatmap, and the phone width"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "links",
      "items": [
        {
          "label": "🌡️ ヒートマップ（ポートフォリオの 🧰 Tools）",
          "href": "https://myon-bioinformatics.github.io/tools/#heatmap"
        }
      ]
    }
  ]
}
